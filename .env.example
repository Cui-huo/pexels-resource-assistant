# Pexels API 配置
# 获取方式：登录 https://www.pexels.com/api/ 申请免费 API Key
PEXELS_API_KEY=YOUR_PEXELS_API_KEY_HERE

# 邮箱配置
# EMAIL_SENDER: 发件人邮箱地址
# EMAIL_PASSWORD: 邮箱 SMTP 授权码（不是登录密码！）
#   - 163 邮箱：登录网易邮箱 → 设置 → POP3/SMTP/IMAP → 开启 SMTP 服务并获取授权码
#   - QQ 邮箱：登录网页版 → 设置 → 账户 → 开启 POP3/SMTP 服务
EMAIL_SENDER=your_email@163.com
EMAIL_PASSWORD=YOUR_EMAIL_AUTH_CODE_HERE
SMTP_SERVER=smtp.163.com
SMTP_PORT=465

# 默认收件人邮箱
DEFAULT_RECEIVER=receiver@example.com
